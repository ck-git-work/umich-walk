<name>Extras: the Arb &amp; North Campus</name>
<Style id="pin"><IconStyle><color>ff9A1B6A</color><scale>1.1</scale><Icon><href>https://www.gstatic.com/mapspro/images/stock/503-wht-blank_maps.png</href></Icon></IconStyle></Style>
