<?xml version="1.0" encoding="UTF-8"?>
<kml xmlns="http://www.opengis.net/kml/2.2"><Document>
<name>Suggested stops</name>
<Style id="pin"><IconStyle><color>ff4C2700</color><scale>1.1</scale><Icon><href>https://www.gstatic.com/mapspro/images/stock/503-wht-blank_maps.png</href></Icon></IconStyle></Style>
<Style id="line"><LineStyle><color>e64C2700</color><width>6</width></LineStyle></Style>
<Placemark><name>1 · Start: S Main &amp; E William</name><styleUrl>#pin</styleUrl><description><![CDATA[Start here, downtown. Head north on Main Street.]]></description><Point><coordinates>-83.74845,42.27884,0</coordinates></Point></Placemark>
<Placemark><name>2 · Main Street (turn at Kingsley)</name><styleUrl>#pin</styleUrl><description><![CDATA[Main Street is the more grown-up side of Ann Arbor: restaurants, bars and shops. Walk north until Kingsley St, then turn right (east).]]></description><Point><coordinates>-83.7486,42.2849,0</coordinates></Point></Placemark>
<Placemark><name>3 · Zingerman&#x27;s Deli</name><styleUrl>#pin</styleUrl><description><![CDATA[A classic. If College GameDay is ever in Ann Arbor, you'll see a shot of Zingerman's. A great deli, and a good place to stop for a meal if you're hungry.<br><br>422 Detroit St]]></description><Point><coordinates>-83.74515,42.2847,0</coordinates></Point></Placemark>
<Placemark><name>4 · East Liberty Street</name><styleUrl>#pin</styleUrl><description><![CDATA[Head back south on Division St, then east on Liberty. E Liberty is the more student-feeling stretch of downtown. Turn left (north) on State St when you reach it.]]></description><Point><coordinates>-83.7439,42.27962,0</coordinates></Point></Placemark>
<Placemark><name>5 · Burton Memorial Tower</name><styleUrl>#pin</styleUrl><description><![CDATA[From State St, go right (east) on E Washington to Ingalls Mall. This is the bell tower.]]></description><Point><coordinates>-83.73871,42.27942,0</coordinates></Point></Placemark>
<Placemark><name>6 · Michigan League (optional)</name><styleUrl>#pin</styleUrl><description><![CDATA[Optional. Worth poking your head in if it's open.]]></description><Point><coordinates>-83.73771,42.27935,0</coordinates></Point></Placemark>
<Placemark><name>7 · Hill Auditorium</name><styleUrl>#pin</styleUrl><description><![CDATA[Cross the street after the tower. Peek in if it's open.]]></description><Point><coordinates>-83.73908,42.27918,0</coordinates></Point></Placemark>
<Placemark><name>8 · The Diag</name><styleUrl>#pin</styleUrl><description><![CDATA[Cross N University Ave and keep going down Ingalls Mall to the Diag, the heart of central campus. Look for the brass block "M" in the middle: students avoid stepping on it. Legend says if you step on it, you'll fail your first exam.]]></description><Point><coordinates>-83.73801,42.2771,0</coordinates></Point></Placemark>
<Placemark><name>9 · Angell Hall &amp; the Fishbowl</name><styleUrl>#pin</styleUrl><description><![CDATA[Go into Angell Hall and see the Fishbowl computer lab. For lack of a better term, it's the heart of LSA (the College of Literature, Science, and the Arts).]]></description><Point><coordinates>-83.73975,42.27672,0</coordinates></Point></Placemark>
<Placemark><name>10 · Shapiro Library (and Hatcher)</name><styleUrl>#pin</styleUrl><description><![CDATA[If seeing the library is on the list: Shapiro is the undergrad library where students actually hang out. It's connected to Hatcher, the grand graduate library.]]></description><Point><coordinates>-83.73719,42.27563,0</coordinates></Point></Placemark>
<Placemark><name>11 · Engineering Arch</name><styleUrl>#pin</styleUrl><description><![CDATA[Leave the Diag through the arch under West Hall (southeast corner). It lets you out at S University & East University.]]></description><Point><coordinates>-83.73627,42.27543,0</coordinates></Point></Placemark>
<Placemark><name>12 · East Quad</name><styleUrl>#pin</styleUrl><description><![CDATA[Walk south on East University. East Quad has a weird residential program (the Residential College). I'd recommend Will NOT do it.]]></description><Point><coordinates>-83.73516,42.27293,0</coordinates></Point></Placemark>
<Placemark><name>13 · Ross School of Business</name><styleUrl>#pin</styleUrl><description><![CDATA[Right (west) on Hill St, then right (north) on Tappan. The new Ross building, which didn't exist when I was there.]]></description><Point><coordinates>-83.73697,42.27278,0</coordinates></Point></Placemark>
<Placemark><name>14 · Law Quad &amp; Law Library Reading Room</name><styleUrl>#pin</styleUrl><description><![CDATA[Go diagonally across the street to the front of the Law Quad. Go look at the Law Library Reading Room if someone will let you in (access may be limited). Tell Will he can pretend he's Harry Potter by studying there.]]></description><Point><coordinates>-83.739,42.274,0</coordinates></Point></Placemark>
<Placemark><name>15 · Michigan Union</name><styleUrl>#pin</styleUrl><description><![CDATA[Exit the Law Quad onto State St. The Union has some food options.]]></description><Point><coordinates>-83.74151,42.27517,0</coordinates></Point></Placemark>
<Placemark><name>16 · The Cube</name><styleUrl>#pin</styleUrl><description><![CDATA[Officially "Endover," in Regents Plaza. For some unknown reason, a Michigan landmark. It spins if you push it.]]></description><Point><coordinates>-83.74189,42.2759,0</coordinates></Point></Placemark>
<Placemark><name>17 · Rally House</name><styleUrl>#pin</styleUrl><description><![CDATA[Walk north on State St: the university on your right, shops on your left, and more shops past where campus ends. Rally House is where to buy some swag if Will is into it.<br><br>303 S State St]]></description><Point><coordinates>-83.74064,42.27916,0</coordinates></Point></Placemark>
<Placemark><name>18 · Back downtown via Liberty</name><styleUrl>#pin</styleUrl><description><![CDATA[Head west on Liberty back to Main Street. The start is one block south.]]></description><Point><coordinates>-83.7484,42.27975,0</coordinates></Point></Placemark>
